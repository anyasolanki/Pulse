# Create a Reddit application with OAuth client credentials, then copy this to .env.
REDDIT_CLIENT_ID=replace_me
REDDIT_CLIENT_SECRET=replace_me
# Use an identifiable User-Agent. Replace your-reddit-username.
REDDIT_USER_AGENT=Pulse-local-prototype/0.1 by /u/your-reddit-username
REDDIT_SUBREDDITS=technology,programming,science
REDDIT_POSTS_PER_SUBREDDIT=25
REDDIT_POLL_INTERVAL=120
